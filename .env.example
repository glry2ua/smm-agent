# Copy this file to .env for local development. Never commit .env.

# Required secret for every run, including dry-run, because the agent generates the post.
OPENAI_API_KEY=
# Image generation model and output settings.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_WIDTH=1088
OPENAI_IMAGE_HEIGHT=1360
OPENAI_IMAGE_QUALITY=medium

# Required for live image publishing. Use the deployed Worker origin, without
# an /assets suffix. Buffer fetches generated images from
# ASSET_PUBLIC_BASE_URL/assets/generated_graphics/...
# In production, set this with `wrangler secret put ASSET_PUBLIC_BASE_URL`.
ASSET_PUBLIC_BASE_URL=

# Required secret values. Keep them in .env locally and in Cloudflare Secrets
# in production; never put the values in wrangler.jsonc or logs.
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=


BUFFER_API_URL=https://api.buffer.com
MIN_SCHEDULE_LEAD_MINUTES=30
SCHEDULE_HORIZON_DAYS=8
MAX_POST_CHARS=5000
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1
