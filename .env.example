# Copy to .env and fill in. Single source of truth for all Worker env values.
# Local: read directly by `wrangler dev` and the Python CLI.
# Production: set each value with `wrangler secret put <NAME>`.

# Secrets
OPENAI_API_KEY=
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=

# Public origin of the deployed Worker (no trailing path); Buffer fetches
# generated images from ASSET_PUBLIC_BASE_URL/assets/generated_graphics/...
ASSET_PUBLIC_BASE_URL=

# Image generation
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_WIDTH=1088
OPENAI_IMAGE_HEIGHT=1360
OPENAI_IMAGE_QUALITY=medium

# Scheduling + retries
BUFFER_API_URL=https://api.buffer.com
MIN_SCHEDULE_LEAD_MINUTES=30
SCHEDULE_HORIZON_DAYS=8
MAX_POST_CHARS=5000
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1