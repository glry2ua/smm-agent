// Commented copy of package.json for humans — npm only reads package.json.
// Mirror script changes here so the notes stay accurate.
{
  "name": "smm-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    // Dev server at localhost:5173; /api, /health and /assets go to a backend on :8787.
    "dev": "vite",
    // Dev server with fake in-memory data — no backend or API keys needed.
    "web-mock": "vite --mode mock",
    // Type-checks the code, then builds the production site into dist/.
    "build": "tsc -b && vite build",
    // Serves the dist/ build locally so you can check it before deploying.
    "preview": "vite preview",
    // Lints the code in src/ with oxlint.
    "lint": "oxlint src",
    // Type-checks the whole project without producing any files.
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-aria": "^3.52.0",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.0.0",
    "react-stately": "^3.50.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tailwindcss-with": "^0.0.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.81.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
