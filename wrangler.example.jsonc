{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smm-agent",
  "main": "src/worker.py",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "assets": {
    "directory": "./web/dist",
    "binding": "WEB",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/assets/generated_graphics/*"]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 14 * * MON"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<your-database-name>",
      "database_id": "<your-database-id>",
      // Dev = prod: wrangler dev uses the real deployed resources; ignored by deploy.
      "remote": true,
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "<your-bucket-name>",
      "remote": true
    }
  ]
}