{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smm-agent",
  "main": "src/worker.py",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "assets": {
    "directory": "./web/dist",
    "binding": "WEB",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/assets/generated_graphics/*"]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 14 * * MON"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smm-agent-db",
      "database_id": "1dd7b92d-0643-4229-9bc9-1103575ed9fe",
      // Dev = prod: wrangler dev runs local code against the real deployed D1.
      // Ignored by `wrangler deploy`.
      "remote": true,
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "smm-agent-assets",
      // Dev = prod: wrangler dev uses the real deployed R2 bucket.
      // Ignored by `wrangler deploy`.
      "remote": true
    }
  ]
}